{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
      "external_directory": {
          "~/.agents/skills/*": "allow"
      }
  },
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "enabled": true,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    }
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ]
}
